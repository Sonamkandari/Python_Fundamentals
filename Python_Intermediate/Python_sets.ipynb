   "source": [
    "# Relationship Methods in sets\n",
    "# issubset()  : Returns true if All items in this set exist in the order\n",
    "\n",
    "# check if a is the subset of b\n",
    "\n",
    "val = {10,50,68,90,34}\n",
    "vale ={10,56,78,50,68,90,34,56,78} \n",
    "print(val.issubset(vale)) # Does vale set contains all the values present in val se \n",
    "# yes it contains there for val is a subset of vale\n",
    "\n",
    "# superset() : Returns true when it includes all Items of the order set\n",
    "print(vale.issuperset(val)) # true\n",
    "\n"
   ]
  }
