   "source": [
    "# In Python, if you want to keep the data unique, we don't use lists. We use, in that case, sets. \n",
    "# Sets: It is an unordered collection of Unique values\n",
    "\n",
    "# check if sets or ordered or not \n",
    "my_set = {10,40,30,5}\n",
    "print(my_set)  # Set is unordered\n",
    "\n",
    "# does sets allow duplicates \n",
    "my_set =  {10,40,30,5,30}\n",
    "print(my_set) # no sets does not allow duplicates\n",
    "\n",
    "# does sets allow indexing\n",
    " # print(my_set[2]) #sets does not allow indexing\n",
    "\n",
    "# check if set allow insertion or not   or check if it is mutable or not\n",
    "# my_set[2] = 9\n",
    "print(my_set)  # sets are immutable we cannot change values in sets once declared\n"
   ]
  },
  {
