   ],
   "source": [
    "# Sets special methods which cannot be used in list\",
    "# Create a set first\n",
    "\n",
    "# How to Add Values to Set\n",
    "a = {10,20,30,35,78}\n",
    "\n",
    "# Note- index based methods do not work with sets\n",
    "# print(a.append(4)) # Append not works here\n",
    "\n",
    "a.add(78) #add method will works for sets\n",
    "print(a)\n",
    "\n",
    "# add() -> It inserts the items somewhere in the set, but only if it is new\n",
    "\n",
    "\n",
    "# Update () -> Merges another group of values (Iterable) in to the set\n",
    "# You can use math operators as quick shortcuts\n",
    "\n",
    "# a.update ({1,2})\n",
    "a.update({4,5})\n",
    "print(a)\n",
    "\n",
    "# another way to implement update is\n",
    "a |= {1,2}\n",
    "\n",
    "# a.remove(100) thrown an error if the value is missing\n",
    "print(a)  # the above remove method for sets is not save methods\n",
    "\n",
    "# In place of a remove method  we used a Discard()\n",
    "# Discard() Removes the item if it exists and does nothing if it does not\n",
    "a.discard(5) # 5 will be removed from  the list\n",
    "print(a)\n",
    "\n",
    "# pop(): Pop removes and returns a random item from a set\n",
    "\n",
    "# Mathematical Operations\n",
    "# Union(): combines All uniques items from both sets\n",
    "\n",
    "a = {10, 20, 30, 40}\n",
    "b = {30, 40, 50, 60}\n",
    "\n",
    "print(a.union(b)) # from the both of the sets only unique values will be combine in a single set\n",
    "# print(a | b) -> this will be the alternative for union\n",
    "\n",
    "# Intersection (): returns only the shared items\n",
    "print(a.intersection(b)) # from the both the sets only common values will be came as an output\n",
    "# print(a&b) -> this will be the alternative for the intersection\n",
    "\n",
    "# Difference(): Returns Items in A, but not in B\n",
    "print(a.difference(b)) # It will be return only those values from a set which is only in the a set\n",
    "print(b.difference(a)) # Again it will be return only those values from b set which is only in the set b\n",
    "\n",
    "# Alternatives for difference\n",
    "print(a-b)\n",
    "print(b-a)\n",
    "\n",
    "# find the None-Shared Values\n",
    "# Symmetric-difference ():Only None-shared items\n",
    "\n",
    "\n",
    "\n",
    "\n"
   ]
  },
